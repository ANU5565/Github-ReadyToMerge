---
// Bookmarks component (scaffold).
//
// The markup below renders during the static build. The dynamic behavior —
// adding a bookmark, generating a short slug, and persisting to the browser —
// must run ONLY in the client-side <script> boundary at the bottom of this
// file. Astro runs that script in the browser, never during the build, so
// browser-only APIs are safe there.
//
// You will implement the behavior in Step 3.
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  import { createSlug, formatBookmark, normalizeUrl, parseBookmarks, type Bookmark } from './bookmarks';

  // CLIENT-SIDE BOUNDARY — runs in the browser only.
  const storageKey = 'mona-bookmarks';
  const form = document.getElementById('add-bookmark') as HTMLFormElement | null;
  const input = document.getElementById('url') as HTMLInputElement | null;
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearAll = document.getElementById('clear-all');
  let bookmarks: Bookmark[] = [];

  function readBookmarks(): Bookmark[] {
    try {
      return parseBookmarks(localStorage.getItem(storageKey));
    } catch {
      return [];
    }
  }

  function writeBookmarks(): void {
    try {
      localStorage.setItem(storageKey, JSON.stringify(bookmarks));
    } catch {
      // Storage can be unavailable or full; the in-memory list remains usable.
    }
  }

  function renderBookmarks(): void {
    if (!list) return;
    list.replaceChildren();

    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';
      item.setAttribute('aria-label', formatBookmark(bookmark));

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noreferrer';
      link.textContent = bookmark.url;

      const separator = document.createTextNode(' :: ');
      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copy = document.createElement('button');
      copy.className = 'copy';
      copy.type = 'button';
      copy.textContent = 'Copy';
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          copy.textContent = 'Copied';
          window.setTimeout(() => { copy.textContent = 'Copy'; }, 1200);
        } catch {
          copy.textContent = 'Copy failed';
          window.setTimeout(() => { copy.textContent = 'Copy'; }, 1200);
        }
      });

      item.append(link, separator, slug, copy);
      list.append(item);
    }

    const hasBookmarks = bookmarks.length > 0;
    if (emptyState) emptyState.hidden = hasBookmarks;
    if (listHeader) listHeader.hidden = !hasBookmarks;
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const url = normalizeUrl(input?.value ?? '');
    if (!url) {
      input?.setCustomValidity('Enter a valid website URL.');
      input?.reportValidity();
      return;
    }

    input?.setCustomValidity('');
    let seed = Date.now() + Math.floor(Math.random() * 1000);
    let slug = createSlug(seed);
    while (bookmarks.some((bookmark) => bookmark.slug === slug)) {
      slug = createSlug(++seed);
    }

    bookmarks = [...bookmarks, { url, slug }];
    writeBookmarks();
    renderBookmarks();
    form.reset();
  });

  clearAll?.addEventListener('click', () => {
    if (!bookmarks.length || !window.confirm('Clear all saved bookmarks?')) return;
    bookmarks = [];
    try {
      localStorage.removeItem(storageKey);
    } catch {
      // Storage can be unavailable; the in-memory list is still cleared.
    }
    renderBookmarks();
  });

  bookmarks = readBookmarks();
  renderBookmarks();
</script>
