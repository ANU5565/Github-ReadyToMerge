---
// Bookmarks component (scaffold).
//
// The markup below renders during the static build. The dynamic behavior —
// adding a bookmark, generating a short slug, and persisting to the browser —
// must run ONLY in the client-side <script> boundary at the bottom of this
// file. Astro runs that script in the browser, never during the build, so
// browser-only APIs are safe there.
//
// You will implement the behavior in Step 3.
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  import { createSlug, formatBookmark, loadBookmarks, normalizeUrl, saveBookmarks } from './bookmark-helpers.js';

  const form = document.getElementById('add-bookmark');
  const list = document.getElementById('bookmark-list');
  const urlInput = document.getElementById('url');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearAll = document.getElementById('clear-all');

  if (!(form instanceof HTMLFormElement)) throw new Error('Expected #add-bookmark form');
  if (!(list instanceof HTMLUListElement)) throw new Error('Expected #bookmark-list list');
  if (!(urlInput instanceof HTMLInputElement)) throw new Error('Expected #url input');
  if (!(emptyState instanceof HTMLElement)) throw new Error('Expected #empty-state element');
  if (!(listHeader instanceof HTMLElement)) throw new Error('Expected #list-header element');
  if (!(clearAll instanceof HTMLButtonElement)) throw new Error('Expected #clear-all button');

  let bookmarks = loadBookmarks(window.localStorage);

  const setState = () => {
    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;
  };

  const render = () => {
    list.textContent = '';

    for (const bookmark of bookmarks) {
      const row = document.createElement('li');
      row.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const separator = document.createElement('span');
      separator.textContent = ' :: ';

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copyButton = document.createElement('button');
      copyButton.type = 'button';
      copyButton.className = 'copy';
      copyButton.textContent = 'Copy';
      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          copyButton.textContent = 'Copied';
          window.setTimeout(() => {
            copyButton.textContent = 'Copy';
          }, 900);
        } catch {
          copyButton.textContent = 'Copy unavailable';
          window.setTimeout(() => {
            copyButton.textContent = 'Copy';
          }, 1200);
        }
      });

      row.append(link, separator, slug, copyButton);
      row.setAttribute('aria-label', formatBookmark(bookmark));
      list.append(row);
    }

    setState();
  };

  form.addEventListener('submit', (event) => {
    event.preventDefault();

    const normalized = normalizeUrl(urlInput.value);
    if (!normalized) return;

    bookmarks = [...bookmarks, { url: normalized, slug: createSlug(window.localStorage) }];
    saveBookmarks(window.localStorage, bookmarks);
    render();
    form.reset();
    urlInput.focus();
  });

  clearAll.addEventListener('click', () => {
    if (!window.confirm('Clear all saved bookmarks?')) return;
    bookmarks = [];
    saveBookmarks(window.localStorage, bookmarks);
    render();
  });

  render();
</script>
